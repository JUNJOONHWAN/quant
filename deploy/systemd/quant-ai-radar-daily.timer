[Unit]
Description=KST 14:30 Tue-Sat Quant AI Radar daily cycle (stored UTC)

[Timer]
# KST intent: Tue-Sat 14:30 Asia/Seoul. Stored/executed: Tue-Sat 05:30 UTC.
# This is after the prior US calendar day has ended, which is required by the
# configured Massive grouped-daily entitlement.
OnCalendar=Tue..Sat *-*-* 05:30:00 UTC
Persistent=true
RandomizedDelaySec=0
Unit=quant-ai-radar-daily.service

[Install]
WantedBy=timers.target
