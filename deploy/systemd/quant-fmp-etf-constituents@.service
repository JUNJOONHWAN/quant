[Unit]
Description=Quant dataset FMP ETF constituent backfill shard %i
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/zooh/Documents/GitHub/quant
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m quant_dataset backfill-fmp-etf-constituents --from 2017-01-01 --to 2026-07-14 --universe-jsonl /home/zooh/Documents/GitHub/STOCKDATA/QUANT_DATASET/state/universe/fmp_us_all_20260714.jsonl --shard-count 4 --shard-index %i
Restart=on-failure
RestartSec=120
TimeoutStopSec=30
Nice=5

[Install]
WantedBy=default.target
