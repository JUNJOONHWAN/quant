[Unit]
Description=Quant dataset full classified FMP training-feature backfill
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/zooh/Documents/GitHub/quant
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m quant_dataset backfill-fmp-training --plan /home/zooh/Documents/GitHub/STOCKDATA/QUANT_DATASET/state/fmp_training_plan_20260715.json --symbols-file /home/zooh/Documents/GitHub/STOCKDATA/QUANT_DATASET/state/universe/fmp_us_equity_etf_20260714.symbols.txt --universe-jsonl /home/zooh/Documents/GitHub/STOCKDATA/QUANT_DATASET/state/universe/fmp_us_all_20260714.jsonl --from 2017-01-01 --to 2026-07-14
Restart=on-abnormal
RestartSec=120
TimeoutStopSec=60
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target
